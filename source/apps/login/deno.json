{
  "name": "@khatm/login",
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "better-auth/client": "npm:better-auth@^1.7.3/client",
    "better-auth/client/plugins": "npm:better-auth@^1.7.3/client/plugins",
    "class-variance-authority": "npm:class-variance-authority@0.7.1",
    "clsx": "npm:clsx@2.1.1",
    "esbuild": "npm:esbuild@0.25.10",
    "react": "npm:react@19.2.0",
    "react-dom": "npm:react-dom@19.2.0",
    "react-dom/client": "npm:react-dom@19.2.0/client",
    "tailwind-merge": "npm:tailwind-merge@3.3.1",
    "tailwindcss": "npm:tailwindcss@4.1.13",
    "@tailwindcss/cli": "npm:@tailwindcss/cli@4.1.13"
  },
  "tasks": {
    "build": "deno run -A build.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.window"
    ],
    "types": [
      "npm:@types/react@19.2.17",
      "npm:@types/react-dom@19.2.3"
    ]
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "trailingCommas": "onlyMultiLine"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "exports": "./src/main.tsx"
}
