{
  "name": "@khatm/console",
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "esbuild": "npm:esbuild@0.25.10",
    "react": "npm:react@19.2.0",
    "react-dom": "npm:react-dom@19.2.0",
    "react-dom/client": "npm:react-dom@19.2.0/client",
    "tailwindcss": "npm:tailwindcss@4.1.13",
    "@tailwindcss/cli": "npm:@tailwindcss/cli@4.1.13",
    "zod": "npm:zod@^4.1.0",
    "playwright-core": "npm:playwright-core@1.55.0"
  },
  "tasks": {
    "build": "deno run -A build.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.window"
    ],
    "types": [
      "npm:@types/react@19.2.17",
      "npm:@types/react-dom@19.2.3"
    ]
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "trailingCommas": "onlyMultiLine"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "exports": "./server.ts"
}
