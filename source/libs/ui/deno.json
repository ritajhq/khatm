{
  "name": "@khatm-libs/ui",
  "exports": "./index.ts",
  "imports": {
    "class-variance-authority": "npm:class-variance-authority@0.7.1",
    "clsx": "npm:clsx@2.1.1",
    "react": "npm:react@19.2.0",
    "tailwind-merge": "npm:tailwind-merge@3.3.1"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.window"
    ],
    "types": [
      "npm:@types/react@19.2.17",
      "npm:@types/react-dom@19.2.3"
    ]
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "trailingCommas": "onlyMultiLine"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
